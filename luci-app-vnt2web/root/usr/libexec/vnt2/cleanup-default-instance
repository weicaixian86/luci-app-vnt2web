#!/bin/sh

# Compatibility cleanup for downloaded vnt2_web releases that still expose
# the standalone --conf file as an automatically-created instance.
HOST="${1:-127.0.0.1}"
PORT="${2:-19099}"
TOKEN="${3:-}"
DEFAULT_FILE="${4:-vnt2web.toml}"
BASE_URL="http://${HOST}:${PORT}"
ATTEMPTS="${VNT2_CLEANUP_ATTEMPTS:-20}"
DELAY="${VNT2_CLEANUP_DELAY:-1}"

[ -n "$TOKEN" ] || exit 0
[ -n "$DEFAULT_FILE" ] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

case "$ATTEMPTS" in
	''|*[!0-9]*|0) exit 0 ;;
esac

AUTH_HEADER="Authorization: Bearer ${TOKEN}"

attempt=1
while [ "$attempt" -le "$ATTEMPTS" ]; do
	instances="$(curl -fsS --connect-timeout 1 --max-time 2 -H "$AUTH_HEADER" "${BASE_URL}/api/instances" 2>/dev/null)" || {
		sleep "$DELAY"
		attempt=$((attempt + 1))
		continue
	}
	instances="$(printf '%s' "$instances" | tr -d '[:space:]')"

	case "$instances" in
		*"\"file_name\":\"${DEFAULT_FILE}\""*)
			status="$(curl -fsS --connect-timeout 1 --max-time 2 -H "$AUTH_HEADER" \
				"${BASE_URL}/api/start/status?file_name=${DEFAULT_FILE}" 2>/dev/null)" || {
				sleep "$DELAY"
				attempt=$((attempt + 1))
				continue
			}
			status="$(printf '%s' "$status" | tr -d '[:space:]')"
			case "$status" in
				*"\"status\":\"stopped\""*) ;;
				*"\"status\":\"running\""*) exit 0 ;;
				*)
					sleep "$DELAY"
					attempt=$((attempt + 1))
					continue
				;;
			esac

			# Only remove an already-stopped compatibility entry. A running or
			# starting default instance may have been explicitly requested by the
			# user and must not be interrupted by a service restart.
			curl -fsS --connect-timeout 1 --max-time 2 \
				-H "$AUTH_HEADER" \
				-X DELETE "${BASE_URL}/api/instance?file_name=${DEFAULT_FILE}" >/dev/null 2>&1 && exit 0
		;;
		*)
			# The HTTP listener can become ready just before an older release
			# registers its implicit default instance.
		;;
	esac

	sleep "$DELAY"
	attempt=$((attempt + 1))
done

exit 0
